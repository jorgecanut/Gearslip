<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material You: DynamicColors.DayNight derives the whole scheme from the device
      wallpaper on Android 12+, and falls back to Material3's static baseline scheme on
      older versions or when DynamicColors.applyToActivityIfAvailable() is skipped.
    -->
    <style name="Theme.Gearslip" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- For PermissionActivity: only Android's own permission dialog shows, over whatever was there. -->
    <style name="Theme.Gearslip.Invisible" parent="Theme.Gearslip">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
