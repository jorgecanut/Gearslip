    <string name="touch_relay_description">Lets Gearslip replay touches from the car screen onto the phone while mirroring. Gearslip does not read screen content.</string>

    <!-- Setup guide -->
    <string name="guide_usage_title">Help other drivers.</string>
    <string name="guide_safety_title">Drive safely.</string>
    <string name="guide_safety_body">Gearslip is unofficial. No carmaker made or checked it, and it can fail without warning. Set it up before you go, then keep your eyes on the road.</string>
    <string name="guide_mic_title">Microphone.</string>
    <string name="guide_mic_body">Gearslip uses it to send your music to the car and to hear you when you ask for something or reply to a message. What you say stays on the phone.</string>
    <string name="guide_location_title">Location.</string>
    <string name="guide_location_body">The car\'s map and nearby searches need it. Without it, the dashboard shows no map.</string>
    <string name="guide_calendar_title">Calendar.</string>
    <string name="guide_calendar_body">The car screen shows your next event. Gearslip only reads your calendar.</string>
    <string name="guide_calls_title">Calls and contacts.</string>
    <string name="guide_calls_body">The car shows who\'s calling by name, and its Phone app can dial a number or call one of your contacts. Gearslip only reads them.</string>
    <string name="guide_bluetooth_title">Bluetooth.</string>
    <string name="guide_bluetooth_body">The first time you plug in, Gearslip offers to pair your phone with the car, so calls play through its speakers.</string>
    <string name="guide_notifications_title">Notifications.</string>
    <string name="guide_notifications_body">While Gearslip is connected, it shows a notification with a button to stop. Without this, Android hides it.</string>
    <string name="guide_messages_title">Messages.</string>
    <string name="guide_messages_body">The car shows your messages, reads them aloud and lets you reply. Turn Gearslip on in the list this opens.</string>
    <string name="guide_android_auto_title">Turn off Android Auto.</string>
    <string name="guide_android_auto_body">Android Auto is still installed, and it fights Gearslip for the car\'s USB connection. Disable or uninstall it on the screen this opens.</string>
    <string name="guide_default_title">Choose Gearslip.</string>
    <string name="guide_default_body">If your phone asks which app to open when you plug into the car, pick Gearslip and tap Always.</string>
    <string name="guide_audio_title">Car audio.</string>
    <string name="guide_audio_body">Pick how music reaches the car. Calls go over Bluetooth either way.</string>
    <string name="guide_voice_title">Voice.</string>
    <string name="guide_voice_body">Ask for directions, music, or a call by voice. Your phone turns speech into text by itself, and nothing you say leaves it. It needs %1$d MB, downloaded once. Use Wi-Fi if you can.</string>
    <string name="guide_audio_prompt_title">No audio prompt.</string>
    <string name="guide_audio_prompt_body">Run this from a computer with USB debugging on, and Android trusts Gearslip with your audio for good. Without it, you tap Start once each drive.</string>
    <string name="guide_readable_title">Readable notifications.</string>
    <string name="guide_readable_body">While audio goes to the car, Android hides what notifications say, as if you were sharing your screen. This lets Gearslip show them during a drive and hide them again after.</string>
    <string name="guide_answer_title">Answer calls.</string>
    <string name="guide_answer_body">Make Gearslip your caller ID app, and the car can answer and decline calls. Without it, calls still ring, but only the phone can answer them.</string>
    <string name="guide_apps_title">Good company.</string>
    <string name="guide_buttons_title">Your buttons.</string>
    <string name="guide_buttons_body">Pick how the car\'s buttons look. Change it any time in the car\'s settings.</string>
